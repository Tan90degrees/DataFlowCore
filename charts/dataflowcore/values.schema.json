{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "worker": {
      "type": "object",
      "properties": {
        "slots": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "enum": [
                "auto"
              ]
            }
          ]
        },
        "cpu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "memoryMB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "runnerDagWorkers": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "string",
              "enum": [
                "auto"
              ]
            }
          ]
        },
        "runnerMapWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "runnerIoWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "runnerIoMapWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "runnerMaxTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "ioConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "resourceAgingSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "control": {
      "type": "object",
      "properties": {
        "maxUnfinished": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "dbTimeoutMS": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "uploadMinFreeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1125899906842624
        },
        "uploadMaxBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "uploadConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    }
  }
}
